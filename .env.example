# Healthcare Decision Support System -- Environment Configuration
# Copy this file to .env and fill in your values before running.
# NEVER commit .env to version control -- it contains secrets.
# Add .env to .gitignore (already included in this project).

# =============================================================
# REQUIRED SETTINGS
# =============================================================

# Django secret key -- generate a strong random value:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode -- set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=healthcare-decision-support-system.onrender.com,localhost,127.0.0.1

# =============================================================
# DATABASE
# =============================================================
# Default: SQLite (no additional setup required for development)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (production):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# =============================================================
# AI SETTINGS -- Google Gemini + ChromaDB
# =============================================================

# --- Gemini API Key ---
# Used for: embeddings (RAG ingestion + retrieval) and LLM clinical explanations.
# Get yours at: https://aistudio.google.com/app/apikey
# IMPORTANT: Never hard-code this key in Python files, templates, or JavaScript.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Gemini Embedding Model ---
# Model used to embed knowledge-base documents and query vectors.
EMBEDDING_MODEL=gemini-embedding-001

# --- ChromaDB Vector Database Path ---
# Local filesystem path where ChromaDB stores the persistent vector index.
# Use a relative path (relative to project root) or an absolute path.
# IMPORTANT: Run this command to populate the vector database:
#   python manage.py ingest_medical_knowledge
CHROMA_DB_PATH=./chroma_db

# --- Gemini LLM Model ---
# Model used to generate structured 6-section clinical explanations.
# Recommended options:
#   gemini-2.5-flash  -- fast, cost-effective, excellent clinical reasoning (default)
#   gemini-2.5-pro    -- highest quality, higher cost
#   gemini-2.0-flash  -- fast alternative
LLM_MODEL=gemini-2.5-flash

# =============================================================
# EMAIL (optional -- for notifications)
# =============================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# =============================================================
# MEDIA & CLOUD STORAGE (Firebase Storage for Render)
# =============================================================
# Set to True in production on Render to persist uploaded reports/scans
USE_FIREBASE_STORAGE=False

# Firebase Storage Bucket name (e.g., your-project-id.appspot.com or your-project-id.firebasestorage.app)
GS_BUCKET_NAME=your-firebase-project.appspot.com
GS_PROJECT_ID=your-firebase-project-id

# Path to Google Cloud Service Account JSON file (optional if GOOGLE_APPLICATION_CREDENTIALS is set)
GS_CREDENTIALS_PATH=path/to/service-account.json

# Local directory fallback when USE_FIREBASE_STORAGE=False
MEDIA_ROOT=media

# =============================================================
# RENDER & CORS (Cross-Origin Resource Sharing)
# =============================================================
# Automatically populated by Render in production:
# RENDER_EXTERNAL_HOSTNAME=healthcare-decision-support-system.onrender.com

# Additional CORS allowed origins (comma-separated):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

