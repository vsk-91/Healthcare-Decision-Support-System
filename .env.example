# Healthcare Decision Support System -- Environment Configuration
# Copy this file to .env and fill in your values before running.
# NEVER commit .env to version control -- it contains secrets.
# Add .env to .gitignore (already included in this project).

# =============================================================
# REQUIRED SETTINGS
# =============================================================

# Django secret key -- generate a strong random value:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode -- set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================
# DATABASE
# =============================================================
# Default: SQLite (no additional setup required for development)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (production):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# =============================================================
# AI SETTINGS -- Google Gemini + ChromaDB
# =============================================================

# --- Gemini API Key ---
# Used for: embeddings (RAG ingestion + retrieval) and LLM clinical explanations.
# Get yours at: https://aistudio.google.com/app/apikey
# IMPORTANT: Never hard-code this key in Python files, templates, or JavaScript.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Gemini Embedding Model ---
# Model used to embed knowledge-base documents and query vectors.
EMBEDDING_MODEL=gemini-embedding-001

# --- ChromaDB Vector Database Path ---
# Local filesystem path where ChromaDB stores the persistent vector index.
# Use a relative path (relative to project root) or an absolute path.
# IMPORTANT: Run this command to populate the vector database:
#   python manage.py ingest_medical_knowledge
CHROMA_DB_PATH=./chroma_db

# --- Gemini LLM Model ---
# Model used to generate structured 6-section clinical explanations.
# Recommended options:
#   gemini-2.5-flash  -- fast, cost-effective, excellent clinical reasoning (default)
#   gemini-2.5-pro    -- highest quality, higher cost
#   gemini-2.0-flash  -- fast alternative
LLM_MODEL=gemini-2.5-flash

# =============================================================
# EMAIL (optional -- for notifications)
# =============================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# =============================================================
# MEDIA FILES
# =============================================================
# Directory where uploaded patient reports are stored
MEDIA_ROOT=media
