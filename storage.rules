rules_version = '2';

// Firebase Storage security rules for Healthcare DSS
service firebase.storage {
  match /b/{bucket}/o {
    // Medical reports and dataset uploads
    match /{allPaths=**} {
      // Allow read access to authenticated requests or public URLs generated by the app
      allow read: if true;
      // Allow writes only from authorized backend services or authenticated doctors/staff
      allow write: if request.auth != null;
    }
  }
}
